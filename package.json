{
  "name": "audio-reader-highlight-site",
  "description": "Demo site for the audio-reader-highlight package",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "prettier --write .",
    "start": "next start",
    "lint": "next lint",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky",
    "build:package": "cd packages/audio-reader-highlight && tsup"
  },
  "author": {
    "name": "Hesbon Osoro",
    "email": "osoro@hesbon.dev",
    "url": "https://hesbon.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hesbon-osoro/audio-reader-highlight.git"
  },
  "homepage": "https://github.com/hesbon-osoro/audio-reader-highlight#readme",
  "bugs": {
    "url": "https://github.com/hesbon-osoro/audio-reader-highlight/issues"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "highlight",
    "react",
    "nextjs",
    "accessibility",
    "units",
    "currency",
    "abbreviations"
  ],
  "dependencies": {
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^1.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "18.2.24",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "husky": "^9.1.6",
    "jest": "^30.5.2",
    "lint-staged": "^15.2.10",
    "prettier": "3.9.10",
    "ts-jest": "^29.4.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=999",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,css,scss,mdx}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "resolutions": {
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.1",
    "**/test-exclude/minimatch": "^11.0.1",
    "**/@eslint/eslintrc/minimatch": "^3.1.3",
    "**/@humanwhocodes/config-array/minimatch": "^3.1.3",
    "**/eslint-plugin-import/minimatch": "^3.1.3",
    "**/eslint-plugin-jsx-a11y/minimatch": "^3.1.3",
    "**/eslint-plugin-react/minimatch": "^3.1.3",
    "**/eslint/minimatch": "^3.1.3",
    "**/rimraf/glob/minimatch": "^3.1.3",
    "postcss": "^8.5.23",
    "**/@next/eslint-plugin-next/glob": "^13.0.6",
    "**/test-exclude/glob": "^13.0.6",
    "**/@jest/reporters/glob": "^13.0.6",
    "**/jest-config/glob": "^13.0.6",
    "**/jest-runtime/glob": "^13.0.6"
  }
}
